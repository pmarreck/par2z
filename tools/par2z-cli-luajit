local function die(msg)
	io.stderr:write(msg, "\n")
	os.exit(1)
end

local function die_invalid(reason)
	if reason then
		die("par2z-cli-luajit: invalid input (" .. reason .. ")")
	end
	die("par2z-cli-luajit: invalid input")
end

local function parse_uint(argstr)
	local n = tonumber(argstr)
	if n == nil or n < 0 then
		return nil
	end
	return n
end

local function parse_create(args)
	local opts = {
		block_size = 0,
		block_count = 0,
		redundancy_percent = 0,
		recovery_blocks = 0,
		first_recovery_block = 0,
		uniform_recovery = 0,
		limit_recovery = 0,
		recovery_file_count = 0,
		include_input_slices = 0,
		emit_packed = 0,
		emit_rfsc = 1,
		include_volume_meta = 1,
	}
	local output_path = nil
	local basepath = nil
	local memory_mb = 0
	local thread_count = 0
	local recurse = false
	local tar = false
	local i = 2
	while i <= #args do
		local a = args[i]
		if a == "--" then
			i = i + 1
			break
		end
		local handled = true
		if a == "-v" or a == "-q" then
			i = i + 1
		elseif a == "--mute-defaults" then
			i = i + 1
		elseif a == "-R" then
			recurse = true
			i = i + 1
		elseif a == "--tar" then
			tar = true
			i = i + 1
		elseif a == "--comment" then
			opts.comment = args[i + 1]
			i = i + 2
		elseif a == "--include-input-slices" then
			opts.include_input_slices = 1
			i = i + 1
		elseif a == "--emit-packed" then
			opts.emit_packed = 1
			i = i + 1
		elseif a == "--no-rfsc" then
			opts.emit_rfsc = 0
			i = i + 1
		elseif a == "--no-volume-meta" then
			opts.include_volume_meta = 0
			i = i + 1
		elseif a == "-a" then
			output_path = args[i + 1]
			i = i + 2
		elseif a:sub(1, 2) == "-a" and #a > 2 then
			output_path = a:sub(3)
			i = i + 1
		elseif a == "--block-size" or a == "-s" then
			opts.block_size = assert(parse_uint(args[i + 1]))
			i = i + 2
		elseif a:sub(1, 2) == "-s" and #a > 2 then
			opts.block_size = assert(parse_uint(a:sub(3)))
			i = i + 1
		elseif a == "--block-count" or a == "-b" then
			opts.block_count = assert(parse_uint(args[i + 1]))
			i = i + 2
		elseif a:sub(1, 2) == "-b" and #a > 2 then
			opts.block_count = assert(parse_uint(a:sub(3)))
			i = i + 1
		elseif a == "--redundancy-percent" or a == "-r" then
			opts.redundancy_percent = assert(parse_uint(args[i + 1]))
			i = i + 2
		elseif a:sub(1, 2) == "-r" and #a > 2 then
			opts.redundancy_percent = assert(parse_uint(a:sub(3)))
			i = i + 1
		elseif a == "--recovery-blocks" or a == "-c" then
			opts.recovery_blocks = assert(parse_uint(args[i + 1]))
			i = i + 2
		elseif a:sub(1, 2) == "-c" and #a > 2 then
			opts.recovery_blocks = assert(parse_uint(a:sub(3)))
			i = i + 1
		elseif a == "-f" then
			opts.first_recovery_block = assert(parse_uint(args[i + 1]))
			i = i + 2
		elseif a:sub(1, 2) == "-f" and #a > 2 then
			opts.first_recovery_block = assert(parse_uint(a:sub(3)))
			i = i + 1
		elseif a == "-u" then
			opts.uniform_recovery = 1
			i = i + 1
		elseif a == "-l" then
			opts.limit_recovery = 1
			i = i + 1
		elseif a == "-n" then
			opts.recovery_file_count = assert(parse_uint(args[i + 1]))
			i = i + 2
		elseif a:sub(1, 2) == "-n" and #a > 2 then
			opts.recovery_file_count = assert(parse_uint(a:sub(3)))
			i = i + 1
		elseif a == "-m" then
			memory_mb = assert(parse_uint(args[i + 1]))
			i = i + 2
		elseif a:sub(1, 2) == "-m" and #a > 2 then
			memory_mb = assert(parse_uint(a:sub(3)))
			i = i + 1
		elseif a == "-B" or a == "--basepath" then
			basepath = args[i + 1]
			i = i + 2
		elseif a:sub(1, 2) == "-B" and #a > 2 then
			basepath = a:sub(3)
			i = i + 1
		elseif a == "-T" then
			thread_count = assert(parse_uint(args[i + 1]))
			i = i + 2
		elseif a:sub(1, 2) == "-T" and #a > 2 then
			thread_count = assert(parse_uint(a:sub(3)))
			i = i + 1
		else
			handled = false
		end
		if not handled then
			break
		end
	end
	local par2_path = nil
	if output_path then
		par2_path = output_path
	else
		par2_path = args[i]
		i = i + 1
	end
	local data_paths = {}
	for j = i, #args do
		table.insert(data_paths, args[j])
	end
	if not par2_path or #data_paths == 0 then
		die("par2z-cli-luajit: missing par2 path or data files")
	end
	if opts.block_size ~= 0 and opts.block_count ~= 0 then
		die_invalid("block size and block count are mutually exclusive")
	end
	if opts.redundancy_percent ~= 0 and opts.recovery_blocks ~= 0 then
		die_invalid("redundancy percent and recovery blocks are mutually exclusive")
	end
	if opts.uniform_recovery ~= 0 and opts.limit_recovery ~= 0 then
		die_invalid("uniform and limit flags are mutually exclusive")
	end
	if opts.limit_recovery ~= 0 and opts.recovery_file_count ~= 0 then
		die_invalid("limit is incompatible with recovery file count")
	end
	if opts.recovery_file_count ~= 0 and (opts.recovery_file_count < 1 or opts.recovery_file_count > 31) then
		die_invalid("recovery file count out of range")
	end
	return opts, par2_path, data_paths, basepath, memory_mb, thread_count, recurse, tar
end

local function parse_verify(args)
	local basepath = nil
	local memory_mb = 0
	local i = 2
	while i <= #args do
		local a = args[i]
		if a == "--" then
			i = i + 1
			break
		end
		local handled = true
		if a == "-m" then
			memory_mb = assert(parse_uint(args[i + 1]))
			i = i + 2
		elseif a:sub(1, 2) == "-m" and #a > 2 then
			memory_mb = assert(parse_uint(a:sub(3)))
			i = i + 1
		elseif a == "-B" or a == "--basepath" then
			basepath = args[i + 1]
			i = i + 2
		elseif a:sub(1, 2) == "-B" and #a > 2 then
			basepath = a:sub(3)
			i = i + 1
		else
			handled = false
		end
		if not handled then
			break
		end
	end
	local par2_path = args[i]
	if not par2_path then
		die("par2z-cli-luajit: missing par2 path")
	end
	i = i + 1
	local data_paths = {}
	for j = i, #args do
		table.insert(data_paths, args[j])
	end
	return par2_path, data_paths, basepath, memory_mb
end

local function parse_recover(args)
	local stdout_only = false
	local tar = false
	local out_dir = nil
	local allow_unsafe = 0
	local basepath = nil
	local memory_mb = 0
	local thread_count = 0
	local i = 2
	while i <= #args do
		local a = args[i]
		if a == "--" then
			i = i + 1
			break
		end
		local handled = true
		if a == "--stdout" then
			stdout_only = true
			i = i + 1
		elseif a == "--tar" then
			tar = true
			i = i + 1
		elseif a == "--allow-unsafe-paths" then
			allow_unsafe = 1
			i = i + 1
		elseif a == "-o" or a == "--out-dir" then
			out_dir = args[i + 1]
			i = i + 2
		elseif a == "-v" or a == "-q" then
			i = i + 1
		elseif a == "-m" then
			memory_mb = assert(parse_uint(args[i + 1]))
			i = i + 2
		elseif a:sub(1, 2) == "-m" and #a > 2 then
			memory_mb = assert(parse_uint(a:sub(3)))
			i = i + 1
		elseif a == "-B" or a == "--basepath" then
			basepath = args[i + 1]
			i = i + 2
		elseif a:sub(1, 2) == "-B" and #a > 2 then
			basepath = a:sub(3)
			i = i + 1
		elseif a == "-T" then
			thread_count = assert(parse_uint(args[i + 1]))
			i = i + 2
		elseif a:sub(1, 2) == "-T" and #a > 2 then
			thread_count = assert(parse_uint(a:sub(3)))
			i = i + 1
		else
			handled = false
		end
		if not handled then
			break
		end
	end
	if stdout_only and tar then
		die("par2z-cli-luajit: --stdout cannot be combined with --tar")
	end
	if stdout_only and out_dir then
		die_invalid("--stdout is incompatible with --out-dir")
	end
	local par2_path = args[i]
	if not par2_path then
		die("par2z-cli-luajit: missing par2 path")
	end
	i = i + 1
	local data_paths = {}
	for j = i, #args do
		table.insert(data_paths, args[j])
	end
	return par2_path, data_paths, out_dir, allow_unsafe, basepath, memory_mb, thread_count, stdout_only, tar
end

local function basename(path)
	return path:match("([^/]+)$") or path
end

local function safe_tar_name(path)
	if path:sub(1, 1) == "/" then
		return basename(path)
	end
	if path:find("%.%.") then
		return basename(path)
	end
	return path
end

local function write_octal(value, width)
	local s = string.format("%0" .. tostring(width) .. "o", value)
	return s
end

local function tar_header(name, size)
	local buf = ffi.new("uint8_t[512]")
	ffi.fill(buf, 512, 0)
	local n = safe_tar_name(name)
	local name_bytes = n
	if #name_bytes > 100 then
		name_bytes = name_bytes:sub(1, 100)
	end
	ffi.copy(buf, name_bytes, #name_bytes)
	ffi.copy(buf + 100, "0000644", 7)
	ffi.copy(buf + 108, "0000000", 7)
	ffi.copy(buf + 116, "0000000", 7)
	ffi.copy(buf + 124, write_octal(size, 11), 11)
	ffi.copy(buf + 136, "00000000000", 11)
	ffi.fill(buf + 148, 8, 0x20)
	buf[156] = string.byte("0")
	ffi.copy(buf + 257, "ustar", 5)
	buf[262] = 0
	ffi.copy(buf + 263, "00", 2)
	local checksum = 0
	for i = 0, 511 do
		checksum = checksum + buf[i]
	end
	local chk = write_octal(checksum, 6)
	ffi.copy(buf + 148, chk, 6)
	buf[154] = 0
	buf[155] = string.byte(" ")
	return ffi.string(buf, 512)
end

local function tar_write_entry(name, chunks, size)
	size = tonumber(size)
	io.stdout:write(tar_header(name, size))
	for _, chunk in ipairs(chunks) do
		io.stdout:write(chunk)
	end
	local pad = (512 - (size % 512)) % 512
	pad = tonumber(pad)
	if pad ~= 0 then
		io.stdout:write(string.rep("\0", pad))
	end
end

local function tar_finish()
	io.stdout:write(string.rep("\0", 1024))
end

local OutCtx = ffi.typeof("struct { int id; }")
local OutCtxPtr = ffi.typeof("struct { int id; }*")
local out_next_id = 1
local out_buffers = {}
local out_names = {}
local stdout_used = false
local stdout_ctx = ffi.new("struct { int id; }", { id = 0 })
local stdout_ctx_ptr = ffi.cast("void*", stdout_ctx)

local function new_buffer(name)
	local id = out_next_id
	out_next_id = out_next_id + 1
	local ctx = ffi.new(OutCtx)
	ctx.id = id
	out_buffers[id] = { name = name, size = 0, chunks = {}, ctx = ctx }
	out_names[name] = id
	return out_buffers[id]
end

local function reset_buffer(buf)
	buf.size = 0
	buf.chunks = {}
end

local write_cb = ffi.cast("Par2WriteFn", function(ctx, data, len)
	if ctx == nil then
		return 0
	end
	if ctx == stdout_ctx_ptr then
		io.stdout:write(ffi.string(data, len))
		return len
	end
	local id = ffi.cast(OutCtxPtr, ctx).id
	local buf = out_buffers[id]
	if not buf then
		return 0
	end
	buf.size = buf.size + len
	buf.chunks[#buf.chunks + 1] = ffi.string(data, len)
	return len
end)

local close_cb = ffi.cast("Par2CloseFn", function(_)
	return
end)

local open_cb = ffi.cast("Par2OpenOutputFn", function(ctx, path, out)
	local mode = ffi.cast("int*", ctx)[0]
	local name = safe_tar_name(ffi.string(path))
	if mode == 1 then
		if stdout_used then
			return lib.PAR2_ERR_INVALID_ARGUMENT
		end
		stdout_used = true
		out.ctx = stdout_ctx_ptr
		out.write = write_cb
		out.close = close_cb
		return lib.PAR2_OK
	end
	local id = out_names[name]
	local buf
	if id then
		buf = out_buffers[id]
		reset_buffer(buf)
	else
		buf = new_buffer(name)
	end
	out.ctx = buf.ctx
	out.write = write_cb
	out.close = close_cb
	return lib.PAR2_OK
end)

local function clear_outputs()
	out_buffers = {}
	out_names = {}
	out_next_id = 1
	stdout_used = false
end

local function write_tar_from_buffers()
	local names = {}
	for name, _ in pairs(out_names) do
		table.insert(names, name)
	end
	table.sort(names)
	for _, name in ipairs(names) do
		local id = out_names[name]
		local buf = out_buffers[id]
		tar_write_entry(name, buf.chunks, buf.size)
	end
	tar_finish()
end

local function check_err(rc, msg, errfn, handle)
	if rc == lib.PAR2_OK then
		return
	end
	local detail = nil
	if errfn and handle ~= nil then
		local cmsg = errfn(handle)
		if cmsg ~= nil then
			detail = ffi.string(cmsg)
		end
	end
	if detail and detail ~= "" then
		die(msg .. ": " .. detail)
	end
	die(msg)
end

local cmd = arg[1]
if cmd == nil or cmd == "--help" or cmd == "-h" then
	io.stdout:write(usage)
	os.exit(0)
end
if cmd == "repair" then
	cmd = "recover"
end

if cmd == "create" then
	local opts_tbl, par2_path, data_paths, basepath, memory_mb, thread_count, recurse, tar = parse_create(arg)
	local opts = ffi.new("Par2CreateOptions")
	opts.block_size = opts_tbl.block_size or 0
	opts.block_count = opts_tbl.block_count or 0
	opts.redundancy_percent = opts_tbl.redundancy_percent or 0
	opts.recovery_blocks = opts_tbl.recovery_blocks or 0
	opts.first_recovery_block = opts_tbl.first_recovery_block or 0
	opts.uniform_recovery = opts_tbl.uniform_recovery or 0
	opts.limit_recovery = opts_tbl.limit_recovery or 0
	opts.recovery_file_count = opts_tbl.recovery_file_count or 0
	opts.include_input_slices = opts_tbl.include_input_slices or 0
	opts.emit_packed = opts_tbl.emit_packed or 0
	opts.emit_rfsc = opts_tbl.emit_rfsc or 0
	opts.include_volume_meta = opts_tbl.include_volume_meta or 0
	opts.thread_count = thread_count or 0
	opts.memory_mb = memory_mb or 0
	opts.basepath = basepath
	opts.comment = opts_tbl.comment

	if recurse then
		local expanded = {}
		for _, p in ipairs(data_paths) do
			local cmdline = "find " .. string.format("%q", p) .. " -type f -print0"
			local pipe = io.popen(cmdline, "r")
			if pipe then
				local content = pipe:read("*a")
				pipe:close()
				for path in content:gmatch("([^%z]+)") do
					table.insert(expanded, path)
				end
			end
		end
		if #expanded > 0 then
			data_paths = expanded
		end
	end

	local handle = ffi.new("Par2CreateHandle*[1]")
	check_err(lib.par2_create_new(opts, handle), "create init failed", lib.par2_create_last_error, handle[0])
	local h = handle[0]
	for _, path in ipairs(data_paths) do
		check_err(lib.par2_create_add_path(h, path), "create add path failed", lib.par2_create_last_error, h)
	end
	check_err(lib.par2_create_set_output_path(h, par2_path), "create set output failed", lib.par2_create_last_error, h)
	local mode = ffi.new("int[1]")
	if tar then
		mode[0] = 2
		check_err(lib.par2_create_set_output_open(h, open_cb, mode), "create set output open failed", lib.par2_create_last_error, h)
	end
	check_err(lib.par2_create_run(h), "create failed", lib.par2_create_last_error, h)
	lib.par2_create_destroy(h)
	if tar then
		write_tar_from_buffers()
		clear_outputs()
	end
	os.exit(0)
elseif cmd == "verify" then
	local par2_path, data_paths, basepath, memory_mb = parse_verify(arg)
	local opts = ffi.new("Par2VerifyOptions")
	opts.memory_mb = memory_mb or 0
	opts.basepath = basepath
	local handle = ffi.new("Par2VerifyHandle*[1]")
	check_err(lib.par2_verify_new(opts, handle), "verify init failed", lib.par2_verify_last_error, handle[0])
	local h = handle[0]
	check_err(lib.par2_verify_set_par2_path(h, par2_path), "verify set par2 failed", lib.par2_verify_last_error, h)
	for _, path in ipairs(data_paths) do
		check_err(lib.par2_verify_add_path(h, path), "verify add path failed", lib.par2_verify_last_error, h)
	end
	check_err(lib.par2_verify_run(h), "verify failed", lib.par2_verify_last_error, h)
	lib.par2_verify_destroy(h)
	os.exit(0)
elseif cmd == "recover" then
	local par2_path, data_paths, out_dir, allow_unsafe, basepath, memory_mb, thread_count, stdout_only, tar = parse_recover(arg)
	local opts = ffi.new("Par2RecoverOptions")
	opts.memory_mb = memory_mb or 0
	opts.allow_unsafe_paths = allow_unsafe or 0
	opts.thread_count = thread_count or 0
	opts.basepath = basepath
	local handle = ffi.new("Par2RecoverHandle*[1]")
	check_err(lib.par2_recover_new(opts, handle), "recover init failed", lib.par2_recover_last_error, handle[0])
	local h = handle[0]
	check_err(lib.par2_recover_set_par2_path(h, par2_path), "recover set par2 failed", lib.par2_recover_last_error, h)
	for _, path in ipairs(data_paths) do
		check_err(lib.par2_recover_add_path(h, path), "recover add path failed", lib.par2_recover_last_error, h)
	end
	if out_dir then
		check_err(lib.par2_recover_set_output_dir(h, out_dir), "recover set output dir failed", lib.par2_recover_last_error, h)
	end
	local mode = ffi.new("int[1]")
	if stdout_only then
		mode[0] = 1
		check_err(lib.par2_recover_set_output_open(h, open_cb, mode), "recover set output open failed", lib.par2_recover_last_error, h)
	elseif tar then
		mode[0] = 2
		check_err(lib.par2_recover_set_output_open(h, open_cb, mode), "recover set output open failed", lib.par2_recover_last_error, h)
	end
	check_err(lib.par2_recover_run(h), "recover failed", lib.par2_recover_last_error, h)
	lib.par2_recover_destroy(h)
	if tar then
		write_tar_from_buffers()
		clear_outputs()
	end
	os.exit(0)
else
	die("par2z-cli-luajit: unknown command")
end
